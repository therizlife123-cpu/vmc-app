@app.route("/dashboard")
def dashboard():
    guard = login_required()
    if guard:
        return guard

    search = request.args.get("search", "").strip()
    selected_month = request.args.get("month") or datetime.now().strftime("%B")
    selected_year_raw = request.args.get("year") or str(datetime.now().year)

    if selected_month not in MONTHS:
        selected_month = datetime.now().strftime("%B")
    try:
        selected_year = int(selected_year_raw)
    except (TypeError, ValueError):
        selected_year = datetime.now().year

    # Get students first.  Do not depend on a fees row existing for every month:
    # build_fee_ledger() treats missing months as unpaid, which is exactly what we
    # need for students who joined in an earlier month and never paid that month.
    cursor.execute(
        """
        SELECT id, student_name, mobile, student_class, subject, timing,
               monthly_fee, joining_date, status
        FROM students
        WHERE student_name LIKE %s
        ORDER BY id DESC
        """,
        (f"%{search}%",),
    )
    students_data = cursor.fetchall()

    students_list = []
    total_expected = Decimal("0.00")
    total_collected = Decimal("0.00")
    total_pending = Decimal("0.00")

    today = datetime.now().date()
    today_key = month_key(today.year, today.month)
    selected_key = month_key(selected_year, MONTHS.index(selected_month) + 1)

    for student in students_data:
        (student_id, student_name, mobile, student_class, subject, timing,
         monthly_fee_raw, joining_date, status) = student
        monthly_fee = Decimal(str(monthly_fee_raw or 0)).quantize(Decimal("0.01"))

        # Selected-month paid amount (used by the monthly overview).
        cursor.execute(
            """SELECT COALESCE(SUM(paid_fee), 0) FROM fees
               WHERE student_id=%s AND month=%s AND year=%s""",
            (student_id, selected_month, selected_year),
        )
        selected_paid = Decimal(str(cursor.fetchone()[0] or 0)).quantize(Decimal("0.01"))

        # Overall outstanding from admission month through the current month.
        ledger = build_fee_ledger(student_id, monthly_fee, joining_date, today)
        overall_pending = sum((r["remaining_fee"] for r in ledger), Decimal("0.00"))

        # Overall paid against all due months. This is useful for the status badge.
        overall_paid = sum((r["paid_fee"] for r in ledger), Decimal("0.00"))
        due_months = len(ledger)

        # Keep the old tuple indexes used by dashboard.html and append:
        # [9] selected-month paid, [10] overall pending.
        row = (student_id, student_name, mobile, student_class, subject, timing,
               monthly_fee, joining_date, status, selected_paid, overall_pending)
        students_list.append(row)

        # Monthly overview remains month-specific.  Overall pending is shown
        # separately and includes all unpaid months since admission.
        chargeable_selected = False
        if joining_date:
            if isinstance(joining_date, datetime):
                joining_date = joining_date.date()
            join_key = month_key(joining_date.year, joining_date.month)
            chargeable_selected = join_key <= selected_key <= today_key

        if status == "Active" and chargeable_selected:
            total_expected += monthly_fee
            total_collected += selected_paid

        # Dashboard pending must be the student's complete outstanding balance.
        if status == "Active":
            total_pending += overall_pending

    cursor.execute("SELECT COUNT(*) FROM students")
    total_students = cursor.fetchone()[0]

    cursor.execute("SELECT COALESCE(SUM(monthly_fee), 0) FROM students WHERE status = 'Active'")
    total_fees = cursor.fetchone()[0]

    collection_percentage = (
        round(float((total_collected / total_expected) * 100), 1)
        if total_expected > 0 else 0
    )
    collection_percentage = min(collection_percentage, 100)

    return render_template(
        "dashboard.html",
        students=students_list,
        total_students=total_students,
        total_fees=total_fees,
        total_collected=total_collected,
        total_pending=total_pending,
        total_expected=total_expected,
        collection_percentage=collection_percentage,
        selected_month=selected_month,
        selected_year=selected_year,
    )


