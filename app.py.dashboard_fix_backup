@app.route("/pay_fee/<int:id>", methods=["GET", "POST"])
def pay_fee(id):
    guard = login_required()
    if guard:
        return guard

    cursor.execute("SELECT id, student_name, monthly_fee, joining_date FROM students WHERE id = %s", (id,))
    student = cursor.fetchone()
    if not student:
        return "Student not found", 404

    student_id, student_name, monthly_fee_raw, joining_date = student
    monthly_fee = Decimal(str(monthly_fee_raw or 0)).quantize(Decimal("0.01"))
    now = datetime.now()
    current_month = now.strftime("%B")
    current_year = now.year
    teacher_id = session["teacher_id"]

    # Build the complete ledger from admission month to the current month.
    # This includes unpaid months even when no fee row exists yet.
    ledger = build_fee_ledger(student_id, monthly_fee, joining_date, now.date())
    current_record = next(
        (r for r in ledger if r["month"] == current_month and r["year"] == current_year),
        None,
    )
    previous_records = [
        r for r in ledger
        if (r["year"] < current_year or
            (r["year"] == current_year and MONTHS.index(r["month"]) < MONTHS.index(current_month)))
        and r["remaining_fee"] > 0
    ]

    previous_pending = sum((r["remaining_fee"] for r in previous_records), Decimal("0.00"))
    current_month_paid = current_record["paid_fee"] if current_record else Decimal("0.00")
    current_month_remaining = current_record["remaining_fee"] if current_record else monthly_fee
    total_outstanding = previous_pending + current_month_remaining

    if request.method == "POST":
        try:
            paid_amount = parse_amount(request.form.get("paid_fee", "0"))
            payment_mode = request.form.get("payment_mode", "Cash").strip() or "Cash"
            remarks = request.form.get("remarks", "").strip() or None

            if paid_amount > total_outstanding:
                flash(f"Maximum payable amount is ₹ {total_outstanding}.", "danger")
                return redirect(url_for("pay_fee", id=id))

            remaining_payment = paid_amount
            payment_date = now.date()

            # Oldest unpaid month first. Missing months are created only when money
            # is actually allocated to them, so payment_date is never fake.
            for record in previous_records:
                if remaining_payment <= 0:
                    break
                allocation = min(remaining_payment, record["remaining_fee"])
                new_paid = record["paid_fee"] + allocation
                new_remaining = max(record["remaining_fee"] - allocation, Decimal("0.00"))
                new_status = "Paid" if new_remaining == 0 else "Partial"

                if record["id"]:
                    cursor.execute(
                        """UPDATE fees SET paid_fee=%s, remaining_fee=%s, status=%s,
                           payment_date=%s, teacher_id=%s WHERE id=%s""",
                        (new_paid, new_remaining, new_status, payment_date, teacher_id, record["id"]),
                    )
                else:
                    cursor.execute(
                        """INSERT INTO fees
                           (student_id, teacher_id, month, year, total_fee, paid_fee,
                            remaining_fee, payment_date, status)
                           VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s)""",
                        (student_id, teacher_id, record["month"], record["year"],
                         record["total_fee"], new_paid, new_remaining, payment_date, new_status),
                    )
                remaining_payment -= allocation

            # Then apply the rest to the current month.
            if remaining_payment > 0 and current_record:
                allocation = min(remaining_payment, current_month_remaining)
                new_paid = current_month_paid + allocation
                new_remaining = max(current_month_remaining - allocation, Decimal("0.00"))
                new_status = "Paid" if new_remaining == 0 else "Partial"
                if current_record["id"]:
                    cursor.execute(
                        """UPDATE fees SET paid_fee=%s, remaining_fee=%s, status=%s,
                           payment_date=%s, teacher_id=%s WHERE id=%s""",
                        (new_paid, new_remaining, new_status, payment_date, teacher_id, current_record["id"]),
                    )
                else:
                    cursor.execute(
                        """INSERT INTO fees
                           (student_id, teacher_id, month, year, total_fee, paid_fee,
                            remaining_fee, payment_date, status)
                           VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s)""",
                        (student_id, teacher_id, current_month, current_year, monthly_fee,
                         new_paid, new_remaining, payment_date, new_status),
                    )
                remaining_payment -= allocation

            cursor.execute(
                """INSERT INTO payments
                   (student_id, amount, payment_month, payment_date, payment_mode, remarks)
                   VALUES (%s,%s,%s,%s,%s,%s)""",
                (student_id, paid_amount, current_month, payment_date, payment_mode[:20], remarks),
            )

            db.commit()
            flash(f"Payment of ₹ {paid_amount} recorded successfully.", "success")
            return redirect(url_for("payment_history", id=student_id))

        except (ValueError, InvalidOperation) as exc:
            db.rollback()
            flash(str(exc), "danger")
        except mysql.connector.Error as exc:
            db.rollback()
            flash(f"Payment could not be saved: {exc}", "danger")

    return render_template(
        "pay_fee.html",
        student=student,
        monthly_fee=monthly_fee,
        already_paid=current_month_paid,
        current_pending=total_outstanding,
        previous_pending=previous_pending,
        current_month=current_month,
        current_year=current_year,
    )


