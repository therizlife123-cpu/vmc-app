MONTHS = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
]
MONTH_ORDER_SQL = ", ".join(f"\'{m}\'" for m in MONTHS)


def month_key(year, month):
    return year * 12 + month - 1


def normalize_joining_date(joining_date):
    if isinstance(joining_date, datetime):
        return joining_date.date()
    if isinstance(joining_date, str):
        return datetime.strptime(joining_date, "%Y-%m-%d").date()
    return joining_date


def build_fee_ledger(student_id, monthly_fee, joining_date, through_date=None):
    """Build a month-by-month fee ledger from admission month through the given month.

    Missing fee rows are treated as virtual pending months. They are NOT inserted until
    an actual payment is made, which keeps payment_date meaningful and works with the
    existing schema where fees.payment_date is NOT NULL.
    """
    joining_date = normalize_joining_date(joining_date)
    through_date = through_date or datetime.now().date()
    if not joining_date or joining_date > through_date:
        return []

    fee = Decimal(str(monthly_fee or 0)).quantize(Decimal("0.01"))
    cursor.execute(
        """SELECT id, month, year, total_fee, paid_fee, remaining_fee, payment_date, status, teacher_id
           FROM fees WHERE student_id=%s""",
        (student_id,),
    )
    existing = {}
    for row in cursor.fetchall():
        existing[(int(row[2]), row[1])] = row

    start = month_key(joining_date.year, joining_date.month)
    end = month_key(through_date.year, through_date.month)
    ledger = []
    for key in range(start, end + 1):
        year = key // 12
        month_no = (key % 12) + 1
        month_name = MONTHS[month_no - 1]
        row = existing.get((year, month_name))
        if row:
            total = Decimal(str(row[3] or 0))
            paid = Decimal(str(row[4] or 0))
            remaining = max(Decimal(str(row[5] or 0)), Decimal("0.00"))
            ledger.append({
                "id": row[0], "month": month_name, "year": year,
                "total_fee": total, "paid_fee": paid, "remaining_fee": remaining,
                "status": row[7], "teacher_id": row[8],
            })
        else:
            ledger.append({
                "id": None, "month": month_name, "year": year,
                "total_fee": fee, "paid_fee": Decimal("0.00"),
                "remaining_fee": fee, "status": "Pending", "teacher_id": None,
            })
    return ledger


def ensure_all_current_fee_records():
    """Compatibility wrapper. Missing months are intentionally virtual until paid."""
    return


def login_required():
