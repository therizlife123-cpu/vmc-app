@app.route("/monthly_report")
def monthly_report():
    guard = login_required()
    if guard:
        return guard

    cursor.execute(
        f"""
        SELECT month, year, SUM(paid_fee) AS total_collection, COUNT(*) AS total_payments
        FROM fees
        GROUP BY year, month
        ORDER BY year DESC, FIELD(month, {MONTH_ORDER_SQL}) DESC
        """
    )
    monthly_data = cursor.fetchall()

    cursor.execute("SELECT COALESCE(SUM(paid_fee), 0) FROM fees")
    report_total_collection = cursor.fetchone()[0]

    cursor.execute("SELECT COUNT(*) FROM fees")
    report_total_payments = cursor.fetchone()[0]

    cursor.execute("SELECT COUNT(DISTINCT CONCAT(year, '-', month)) FROM fees")
    report_total_months = cursor.fetchone()[0]

    chart_labels = [f"{row[0]} {row[1]}" for row in monthly_data]
    chart_values = [float(row[2] or 0) for row in monthly_data]

    return render_template(
        "monthly_report.html",
        monthly_data=monthly_data,
        report_total_collection=report_total_collection,
        report_total_payments=report_total_payments,
        report_total_months=report_total_months,
        chart_labels=chart_labels,
        chart_values=chart_values,
    )


if __name__ == "__main__":
    app.run(debug=True)
